APP_NAME="AutoGest Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données ───────────────────────────────────────
# En local : SQLite (fichier database/database.sqlite)
DB_CONNECTION=sqlite

# Option PostgreSQL (Neon, Supabase, Aiven…) pour conserver les données en démo :
# DB_CONNECTION=pgsql
# DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Charger les comptes de démo au premier démarrage du conteneur (base vide uniquement)
# DEMO_SEED=true

# Mode démonstration public : boutons « Essayer la démo » (sans identifiants),
# changement de mot de passe et gestion des utilisateurs bloqués,
# données remises à zéro automatiquement toutes les DEMO_RESET_HOURS heures.
# DEMO_MODE=true
# DEMO_RESET_HOURS=24

# ── Connexion avec Google (facultatif) ────────────────────
# console.cloud.google.com → API et services → Identifiants → ID client OAuth (Application Web)
# URI de redirection autorisée : <APP_URL>/auth/google/callback
# Sans ces deux valeurs, le bouton Google est masqué.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
